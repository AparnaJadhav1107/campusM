# Copy server/.env.example to server/.env and client/.env.example to client/.env
# Server (server/.env): PORT, NODE_ENV, MONGODB_URI (MongoDB Atlas), JWT_SECRET, JWT_EXPIRES_IN, CLIENT_URL, BCRYPT_SALT_ROUNDS, ADMIN_NAME, ADMIN_EMAIL, ADMIN_PASSWORD, DEMO_STUDENT_EMAIL, DEMO_STUDENT_PASSWORD
# Client (client/.env): VITE_API_URL=http://localhost:5000/api
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/smart_campus?retryWrites=true&w=majority
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
BCRYPT_SALT_ROUNDS=10
ADMIN_NAME=Campus Admin
ADMIN_EMAIL=admin@campus.edu
ADMIN_PASSWORD=Admin@123
DEMO_STUDENT_EMAIL=student@campus.edu
DEMO_STUDENT_PASSWORD=Student@123
VITE_API_URL=http://localhost:5000/api
